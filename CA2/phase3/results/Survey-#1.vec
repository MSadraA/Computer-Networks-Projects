version 3
run Survey-1-20261124-23:03:23-60374
attr configname Survey
attr datetime 20261124-23:03:23
attr datetimef 20261124-230323
attr experiment Survey
attr inifile omnetpp.ini
attr iterationvars ""
attr iterationvarsd ""
attr iterationvarsf ""
attr measurement ""
attr network Roaming
attr processid 60374
attr repetition 1
attr replication #1
attr resultdir results
attr runnumber 1
attr seedset 1
config cmdenv-redirect-output true
config image-path /home/sadra/omnetpp-6.4.0/samples/inet-4.7.0/images
config description "a receive-only meter walks the same path and records every beacon of both APs"
config repeat 3
config *.survey true
config *.meter.wlan[0].radio.channelNumber 1
config *.meter.wlan[1].radio.channelNumber 3
config *.meter.wlan[0].mgmt.accessPointAddress "\"10:00:00:00:00:01\""
config *.meter.wlan[1].mgmt.accessPointAddress "\"10:00:00:00:00:02\""
config *.meter.wlan[*].radio.minSnir.result-recording-modes +vector
config *.meter.wlan[*].radio.minSnir:vector.vector-recording true
config network Roaming
config Contention.**.wlan*.bitrate 54Mbps
config Contention.**.cli.reqLength 900B
config Anomaly.n 5
config Anomaly.host[0].wlan[*].bitrate 9Mbps
config Anomaly.host[*].wlan[*].bitrate 54Mbps
config Anomaly.ap.wlan[*].bitrate 54Mbps
config Anomaly.**.messageLength 900B
config Anomaly.ap.**.pendingQueue.numQueues 5
config Roaming.D 51m
config Roaming.radioMedium.pathLoss.alpha 3.2
config Roaming.radioMedium.pathLoss.sigma 3
config Roaming.ap*.wlan.mgmt.beaconInterval 100ms
config Roaming.host.wlan.mgmt.numChannels 7
config Roaming.*.mobility.turtleScript "xml(\"<movement><set x='50' y='102' speed='1.75' angle='0'/><forward d='51'/></movement>\")"
config sim-time-limit 120s
config **.vector-recording false
config **.constraintAreaMinX 0m
config **.constraintAreaMinY 0m
config **.constraintAreaMinZ 0m
config **.constraintAreaMaxX 600m
config **.constraintAreaMaxY 200m
config **.constraintAreaMaxZ 0m
config **.mobility.initialZ 0m
config **.mobility.initFromDisplayString false
config *.radioMedium.pathLoss.typename LogNormalShadowing
config *.radioMedium.sameTransmissionStartTimeCheck "\"ignore\""
config *.radioMedium.analogModel.ignorePartialInterference true
config **.opMode "\"a\""
config **.radio.bandName "\"5 GHz (20 MHz)\""
config **.radio.transmitter.power 20mW
config **.wlan*.bitrate 12Mbps
config **.rateSelection.mgmtFrameBitrate 6Mbps
config **.rateSelection.multicastFrameBitrate 6Mbps
config *.ap1.wlan.address "\"10:00:00:00:00:01\""
config *.ap2.wlan.address "\"10:00:00:00:00:02\""
config *.ap*.wlan.mgmt.ssid "\"CA2\""
config *.ap1.wlan.radio.channelNumber 1
config *.ap2.wlan.radio.channelNumber 3
config *.host.cli.destAddress "\"20:00:00:00:00:00\""
config *.host.cli.sendInterval 20ms
config *.host.cli.reqLength 160B
config *.host.cli.respLength 0B
config *.host.cli.startTime 1s

